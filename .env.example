# Copy to .env and fill in. .env is in .gitignore — never commit real secrets.

# PostgreSQL password (required; used by both the postgres and app containers).
# Pick a strong value: an existing postgres volume keeps whatever password it was
# created with, so changing this later means recreating the volume (and the data).
DATABASE_PASSWORD=

# Site login. The whole site is closed without a password.
# ADMIN_PASSWORD: parse button + settings (parse time, proxies). TEAM_PASSWORD: view only.
# Empty = that login is disabled. Passwords must differ. Changing one logs that role out.
# SESSION_SECRET signs session cookies (empty = everyone is logged out on restart).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=
TEAM_PASSWORD=
SESSION_SECRET=

# Behind a reverse proxy (nginx/Caddy) put its address here as seen from the app
# (in Docker usually the bridge gateway, e.g. 172.18.0.1), so the login limiter sees
# real client IPs and cookies get the Secure flag over HTTPS. Never use * when port
# 8090 is reachable directly: anyone could then forge their IP.
# The production overlay sets this for you from CADDY_IP below — leave it alone there.
FORWARDED_ALLOW_IPS=127.0.0.1

# Telegram bot (optional). Notifications are off unless TELEGRAM_NOTIFY=true.
# Digest of changes (once per parse, only if something changed) goes to every
# /start subscriber and to TELEGRAM_CHAT_ID. Parse failures go only to TELEGRAM_ADMIN_CHAT.
# Chat ids are numeric; groups look like -1001234567890 (the bot must be a member).
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY=false
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT=

# Public dashboard address for "в дашборде" links in messages (empty = no links)
DASHBOARD_URL=

# Initial daily parse time, HH:MM Moscow time (the admin changes it in Settings afterwards)
SCHEDULER_TIME=10:00

# Parse immediately on startup
# RUN_NOW=true

# ─── Production only (docker-compose.prod.yml) ───────────────────────────────
# Caddy serves this domain over HTTPS and gets the certificate itself. The
# domain's A record must already point at this server, or issuance fails.
DOMAIN=
# Let's Encrypt sends certificate-expiry warnings here. Required.
ACME_EMAIL=

# Caddy's address on edge-network — the network it shares with the app, and the
# only one it is on, so it can never reach Postgres. uvicorn trusts X-Forwarded-* only
# from this exact address, so the two must stay in step. Change both only if the
# default range collides with another docker network (`docker network ls`).
# CADDY_SUBNET=172.28.0.0/16
# CADDY_IP=172.28.0.10

# Makes every `docker compose ...` run in this directory use the production
# overlay, so the long -f flags never have to be repeated — and the stack can no
# longer be started by accident without its TLS front door.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
